{
  "manifest_version": 3,
  "name": "DataPass Edge Workspaces & Dashboard",
  "short_name": "DataPass",
  "version": "0.2.0",
  "description": "IDE-style workspaces and modular local-first personal dashboard for Edge.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Open DataPass workspaces"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "optional_host_permissions": [
    "https://news.google.com/*",
    "https://feeds.bbci.co.uk/*",
    "https://api.github.com/*"
  ]
}
